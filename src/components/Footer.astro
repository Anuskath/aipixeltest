---
// Footer.astro - Clean Raycast footer with legal & trust links (Multilingual)
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  currentLang?: SupportedLanguage;
}

const lang = Astro.props.currentLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="py-12 border-t border-hairline bg-canvas text-mute text-xs font-mono transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Left: Brand & Tagline -->
      <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
        <a href={translatePath('/')} class="flex items-center gap-2 group">
          <div class="w-5 h-5 rounded bg-surface-elevated border border-hairline flex items-center justify-center">
            <div class="w-2 h-2 rounded-xs bg-accent-red"></div>
          </div>
          <span class="font-sans font-bold text-ink text-sm">PixelTest<span class="text-accent-red">.AI</span></span>
        </a>
        <span class="hidden sm:inline text-stone">•</span>
        <span class="text-charcoal font-sans text-xs">{t('footer.tagline')}</span>
      </div>

      <!-- Quick Nav Links -->
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs">
        <a href={translatePath('/#tester')} class="hover:text-ink transition-colors">{t('nav.tester')}</a>
        <a href={translatePath('/#fixer')} class="hover:text-ink transition-colors">{t('nav.fixer')}</a>
        <a href={translatePath('/#diagnostics')} class="hover:text-ink transition-colors">{t('nav.diagnostics')}</a>
        <a href={translatePath('/#warranty-guide')} class="hover:text-ink transition-colors">{t('nav.warranty')}</a>
        <a href={translatePath('/#faq')} class="hover:text-ink transition-colors">{t('nav.faq')}</a>
        <span class="text-stone">|</span>
        <a href={translatePath('/about')} class="hover:text-ink transition-colors">{t('footer.about')}</a>
        <a href={translatePath('/privacy')} class="hover:text-ink transition-colors">{t('footer.privacy')}</a>
        <a href={translatePath('/terms')} class="hover:text-ink transition-colors">{t('footer.terms')}</a>
        <a href={translatePath('/contact')} class="hover:text-ink transition-colors">{t('footer.contact')}</a>
      </div>

    </div>

    <!-- Bottom Disclaimer Row -->
    <div class="mt-8 pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-stone text-[11px]">
      <div>
        © {new Date().getFullYear()} aipixeltest.com. {t('footer.rights')}
      </div>
      <div class="flex items-center gap-4">
        <span>{t('footer.noCookies')}</span>
        <span>•</span>
        <span>{t('footer.noTracking')}</span>
        <span>•</span>
        <span>{t('footer.clientSide')}</span>
      </div>
    </div>
  </div>
</footer>
