---
// Layout.astro - Primary HTML Shell with Multi-Language (i18n) & Hreflang SEO Support
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getCleanPathname, getHreflangAlternates } from '../i18n/utils';
import { languages, defaultLang, type SupportedLanguage } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const purePath = getCleanPathname(Astro.url);
const siteUrl = 'https://aipixeltest.com';

const title = Astro.props.title || t('meta.title');
const description = Astro.props.description || t('meta.description');
const keywords = t('meta.keywords');

const canonicalUrl = Astro.props.canonicalUrl || (
  currentLang === defaultLang 
    ? `${siteUrl}${purePath ? `/${purePath}` : '/'}`
    : `${siteUrl}/${currentLang}${purePath ? `/${purePath}/` : '/'}`
);

const hreflangs = getHreflangAlternates(purePath, siteUrl);
const langConfig = languages[currentLang] || languages.en;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <!-- Google tag (gtag.js) - Google Tag Manager / Analytics: GTM-TTP2KSX8 -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TTP2KSX8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Alternates for International Multilingual SEO -->
    {hreflangs.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={item.href} />
    ))}

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="PixelTest AI" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="PixelTest AI" />
    <meta property="og:locale" content={langConfig.ogLocale} />
    <meta property="og:image" content="https://aipixeltest.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PixelTest AI - Online Monitor Dead Pixel Test and Stuck Pixel Fixer" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://aipixeltest.com/og-image.png" />
    <meta property="twitter:image:alt" content="PixelTest AI Screen Diagnostic Tool" />

    <!-- Theme Initialization Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.add('light');
        } else if (storedTheme === 'dark') {
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.remove('light');
        }
      })();
    </script>

    <!-- Google Fonts: Inter with ss03 & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data (JSON-LD): WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "PixelTest AI",
      "url": canonicalUrl,
      "inLanguage": currentLang,
      "description": description,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All (Windows, macOS, Linux, iOS, Android)",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Fullscreen API support.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Full-screen RGB dead pixel test",
        "Monitor pixel test and stuck pixel test",
        "Screen pixel size and phone screen pixel pitch analysis",
        "Targeted subpixel cycle flasher",
        "Backlight bleed & uniformity detector",
        "Live display resolution & refresh rate detection"
      ]
    })} />

    <!-- Structured Data (JSON-LD): HowTo -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Test Your Screen for Dead and Stuck Pixels",
      "inLanguage": currentLang,
      "description": "Step-by-step instructions to run an online monitor pixel test and inspect any display for dead pixels, stuck pixels, or backlight bleed.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Clean the Display Surface",
          "text": "Wipe your monitor or phone screen gently with a clean microfiber cloth to remove dust and smudges before starting the test."
        },
        {
          "@type": "HowToStep",
          "name": "Launch Fullscreen Pixel Test",
          "text": "Click the Launch Fullscreen Test button or press F to fill the entire display with solid testing colors."
        },
        {
          "@type": "HowToStep",
          "name": "Inspect Pure White & Black Screens",
          "text": "Check the pure white screen for dark/black specks (dead pixels), and the pure black screen for bright colored dots (stuck pixels)."
        },
        {
          "@type": "HowToStep",
          "name": "Cycle Primary RGB Colors",
          "text": "Use the arrow keys or spacebar to cycle through pure Red, Green, and Blue screens to evaluate individual subpixel health."
        },
        {
          "@type": "HowToStep",
          "name": "Apply the Stuck Pixel Fixer",
          "text": "If you detect a stuck red, green, or blue subpixel, position the subpixel cycle flasher directly over it for 10 to 30 minutes to stimulate the transistor matrix without physical contact."
        }
      ]
    })} />
  </head>
  <body class="bg-canvas text-ink antialiased selection:bg-accent-red selection:text-white">
    <slot />
  </body>
</html>
