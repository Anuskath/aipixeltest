---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { nonDefaultLanguages, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return nonDefaultLanguages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const t = useTranslations(currentLang);
---

<Layout 
  title={`${t('footer.privacy')} | PixelTest AI`}
  description="Privacy Policy for aipixeltest.com. Learn how we respect your privacy with 100% client-side display testing, zero tracking cookies, and zero personal data collection."
  lang={currentLang}
>
  <Header currentLang={currentLang} />

  <main class="py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Title -->
      <div class="space-y-3 mb-10 pb-8 border-b border-hairline">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-accent-blue/10 border border-accent-blue/20 text-xs font-mono text-accent-blue">
          <span>Trust & Privacy</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink font-sans">
          {t('footer.privacy')}
        </h1>
        <p class="text-xs sm:text-sm text-mute font-mono">
          Last Updated: November 2026 • aipixeltest.com
        </p>
      </div>

      <!-- Content -->
      <article class="space-y-8 text-xs sm:text-sm text-body leading-relaxed">
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-ink font-sans">1. Our Core Commitment: Zero Data Collection</h2>
          <p>
            At <strong class="text-ink">PixelTest AI</strong>, your digital privacy is our foremost priority. We have deliberately engineered this application to operate <strong class="text-ink">100% client-side</strong> within your web browser's local sandbox.
          </p>
          <p>
            We do not require user accounts, passwords, email registrations, or personal identifying information to use our online pixel test or stuck pixel fixer tools.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-ink font-sans">2. Information We Process</h2>
          <div class="raycast-card p-4 bg-surface space-y-2">
            <h3 class="font-semibold text-ink text-xs uppercase tracking-wider font-mono">Local Hardware Diagnostics Only</h3>
            <p class="text-xs text-mute">
              When you load our diagnostics page, your web browser executes client-side JavaScript to determine display attributes (screen width, height, DPR, refresh rate). None of this diagnostic information is ever transmitted, logged, or saved to our servers.
            </p>
          </div>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-bold text-ink font-sans">3. Cookies, Storage, and Advertising Disclosures</h2>
          <p>
            PixelTest AI uses standard browser <code class="font-mono text-ink bg-surface-elevated px-1 py-0.5 rounded text-xs">localStorage</code> strictly to store your selected UI theme preference.
          </p>
          <div class="raycast-card p-4 bg-surface space-y-2 mt-2">
            <h3 class="font-semibold text-ink text-xs uppercase tracking-wider font-mono">Google AdSense & Third-Party Advertising Vendors</h3>
            <p class="text-xs text-mute leading-relaxed">
              Third-party vendors, including Google, use cookies (such as DoubleClick) to serve ads based on prior visits. Users may opt out of personalized advertising by visiting Google Ads Settings or aboutads.info.
            </p>
          </div>
        </section>
      </article>

    </div>
  </main>

  <Footer currentLang={currentLang} />
</Layout>
