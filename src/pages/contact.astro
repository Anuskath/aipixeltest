---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contact Us | PixelTest AI"
  description="Contact the team at aipixeltest.com. Send inquiries, feature requests, bug reports, or feedback regarding our screen dead pixel test and monitor tools."
  canonicalUrl="https://aipixeltest.com/contact"
>
  <Header />

  <main class="py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Title -->
      <div class="space-y-3 mb-10 pb-8 border-b border-hairline">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-accent-blue/10 border border-accent-blue/20 text-xs font-mono text-accent-blue">
          <span>Get in Touch</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink font-sans">
          Contact Us
        </h1>
        <p class="text-xs sm:text-sm text-mute font-mono">
          Have feedback, found a display bug, or want to suggest a new test mode? We'd love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Left: Contact Details & Info -->
        <div class="md:col-span-5 space-y-6">
          <div class="raycast-card p-5 bg-surface space-y-4">
            <h3 class="text-sm font-semibold text-ink font-sans">Direct Email</h3>
            <p class="text-xs text-mute leading-relaxed">
              For general support, media inquiries, or technical bug reports:
            </p>
            <div class="font-mono text-xs text-accent-blue select-all bg-surface-elevated p-2 rounded border border-hairline">
              support@aipixeltest.com
            </div>
            <div class="text-[11px] text-stone">
              Average response time: 24–48 business hours.
            </div>
          </div>

          <div class="raycast-card p-5 bg-surface space-y-3">
            <h3 class="text-sm font-semibold text-ink font-sans">Common Topics</h3>
            <ul class="text-xs text-mute space-y-2 list-disc pl-4">
              <li>Bug reports on specific mobile devices or browsers</li>
              <li>Requests for custom test patterns or colors</li>
              <li>Warranty policy updates for monitor brands</li>
              <li>Press and media mentions</li>
            </ul>
          </div>
        </div>

        <!-- Right: Interactive Contact Form -->
        <div class="md:col-span-7">
          <div class="raycast-card p-6 bg-surface">
            
            <form id="contact-form" class="space-y-4">
              
              <!-- Name -->
              <div>
                <label for="contact-name" class="block text-xs font-mono uppercase tracking-wider text-mute mb-1.5">
                  Your Name
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required
                  placeholder="e.g. Alex Miller" 
                  class="w-full bg-surface-elevated border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-hairline-strong transition-colors"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="contact-email" class="block text-xs font-mono uppercase tracking-wider text-mute mb-1.5">
                  Email Address
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required
                  placeholder="you@example.com" 
                  class="w-full bg-surface-elevated border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-hairline-strong transition-colors"
                />
              </div>

              <!-- Topic -->
              <div>
                <label for="contact-topic" class="block text-xs font-mono uppercase tracking-wider text-mute mb-1.5">
                  Topic
                </label>
                <select 
                  id="contact-topic" 
                  name="topic" 
                  class="w-full bg-surface-elevated border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-hairline-strong transition-colors cursor-pointer"
                >
                  <option value="feedback">General Feedback</option>
                  <option value="bug">Report a Bug / Issue</option>
                  <option value="feature">Suggest a Feature</option>
                  <option value="partnership">Business / Partnership</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="contact-message" class="block text-xs font-mono uppercase tracking-wider text-mute mb-1.5">
                  Message
                </label>
                <textarea 
                  id="contact-message" 
                  name="message" 
                  rows="4" 
                  required
                  placeholder="How can we help you?" 
                  class="w-full bg-surface-elevated border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-hairline-strong transition-colors resize-none"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                id="contact-submit-btn"
                class="raycast-pill-btn w-full !py-2.5 text-xs font-semibold cursor-pointer active:scale-[0.99]"
              >
                Send via Email App ✉️
              </button>

              <!-- Delivery Status & Fallback Info -->
              <div id="contact-status" class="hidden p-3.5 rounded-lg bg-surface-elevated border border-hairline text-xs space-y-2.5">
                <div class="flex items-center gap-2 text-accent-green font-medium">
                  <span>✓</span>
                  <span>Opening your email client to send message...</span>
                </div>
                <p class="text-mute text-[11px] leading-relaxed">
                  If your browser or device did not open an email app automatically, you can copy your message or email us directly at <span class="font-mono text-ink">support@aipixeltest.com</span>.
                </p>
                <div class="flex flex-wrap gap-2 pt-1">
                  <button 
                    type="button" 
                    id="btn-copy-email"
                    class="px-2.5 py-1 rounded bg-surface border border-hairline text-[11px] font-mono text-ink hover:border-hairline-strong cursor-pointer"
                  >
                    📋 Copy support@aipixeltest.com
                  </button>
                  <button 
                    type="button" 
                    id="btn-copy-body"
                    class="px-2.5 py-1 rounded bg-surface border border-hairline text-[11px] font-mono text-ink hover:border-hairline-strong cursor-pointer"
                  >
                    📋 Copy Full Message
                  </button>
                </div>
                <div id="copy-toast" class="hidden text-[10px] text-accent-green font-mono">
                  Copied to clipboard!
                </div>
              </div>

            </form>

          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusBox = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
  const btnCopyEmail = document.getElementById('btn-copy-email');
  const btnCopyBody = document.getElementById('btn-copy-body');
  const copyToast = document.getElementById('copy-toast');

  let lastCompiledMessage = '';

  function showToast(text: string) {
    if (!copyToast) return;
    copyToast.textContent = text;
    copyToast.classList.remove('hidden');
    setTimeout(() => copyToast.classList.add('hidden'), 2500);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
    const email = (document.getElementById('contact-email') as HTMLInputElement)?.value || '';
    const topic = (document.getElementById('contact-topic') as HTMLSelectElement)?.value || 'General';
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

    const subject = `[PixelTest AI] ${topic.toUpperCase()} - Inquiry from ${name}`;
    const body = `Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\nMessage:\n${message}\n\n---\nSent via aipixeltest.com`;
    lastCompiledMessage = body;

    const mailtoUrl = `mailto:support@aipixeltest.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    if (statusBox) statusBox.classList.remove('hidden');

    // Trigger user's mail client
    window.location.href = mailtoUrl;
  });

  btnCopyEmail?.addEventListener('click', () => {
    navigator.clipboard.writeText('support@aipixeltest.com').then(() => {
      showToast('Email address copied to clipboard!');
    });
  });

  btnCopyBody?.addEventListener('click', () => {
    if (lastCompiledMessage) {
      navigator.clipboard.writeText(lastCompiledMessage).then(() => {
        showToast('Full message copied to clipboard!');
      });
    }
  });
</script>
